      "modelPrediction": {
        "action": "recommend",
        "originId": "area:新宿",
        "foodTerms": ["cafe"],
        "travelMode": "none"
      },
      "expected": {
        "askWalkIn": true,
        "action": "recommend",
        "travelMode": "none",
        "maxMinutes": null
      }
    },
    {
      "caseId": "japanese-ten-minute-walk-is-travel",
      "query": "新宿駅から徒歩10分以内のカフェ",
      "options": [
        { "id": "station:新宿", "kind": "station", "names": ["新宿駅"] }
      ],
      "modelPrediction": {
        "action": "recommend",
        "originId": "station:新宿",
        "foodTerms": ["cafe"],
        "travelMode": "none"
      },
      "expected": {
        "askWalkIn": false,
        "action": "recommend",
        "travelMode": "walk",
        "maxMinutes": 10
      }
    }
  ]
}
