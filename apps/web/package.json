{
  "name": "@japan-atlas/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "build:agent-poc": "vinext build --mode agent-poc",
    "preflight:agent-poc": "node --experimental-strip-types scripts/agent-poc-deployment-preflight.ts --config wrangler.agent-poc.local.jsonc --built-config dist/server/wrangler.json --secret-list .wrangler/agent-poc-secret-names.json",
    "deploy:agent-poc": "npm run build:agent-poc && npm run preflight:agent-poc && wrangler deploy --config dist/server/wrangler.json --strict",
    "build:owner-poc": "vinext build --mode owner-poc",
    "preflight:owner-poc": "node --experimental-strip-types scripts/owner-poc-deployment-preflight.ts --config wrangler.owner-poc.local.jsonc --built-config dist/server/wrangler.json --secret-list .wrangler/owner-poc-secret-names.json --seed-manifest ../../features/004-openclaw-atlas-poc/deployment/cloudflare-owner-poc/owner-poc-seed-v1.json --seed-evidence .wrangler/owner-poc-seed-evidence.json",
    "deploy:owner-poc": "npm run build:owner-poc && npm run preflight:owner-poc && wrangler deploy --config dist/server/wrangler.json --strict",
    "lint": "oxlint app features lib components product scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check app components db features lib product scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "migration:check": "node --experimental-strip-types scripts/migration-packaging.ts --candidate-site-version 17",
    "db:generate": "drizzle-kit generate",
    "maintenance:assessment-reset": "node --experimental-strip-types scripts/assessment-reset-maintenance.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.5.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.4"
    }
  },
  "type": "module"
}
