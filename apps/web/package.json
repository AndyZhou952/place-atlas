{
  "name": "@japan-atlas/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "build:owner-poc": "vinext build --mode owner-poc",
    "preflight:owner-poc": "node --experimental-strip-types scripts/owner-poc-deployment-preflight.ts --config wrangler.owner-poc.local.jsonc --built-config dist/server/wrangler.json --secret-list .wrangler/owner-poc-secret-names.json",
    "deploy:owner-poc": "npm run build:owner-poc && npm run preflight:owner-poc && wrangler deploy --config dist/server/wrangler.json --strict",
    "test:route-sidecar": "node --experimental-strip-types --test route-sidecar/*.test.mjs scripts/route-sidecar-bundle-preflight.test.mjs scripts/route-sidecar-deployment-preflight.test.mjs",
    "build:route-sidecar": "wrangler deploy --config wrangler.route-sidecar.jsonc --dry-run --outdir dist/route-sidecar --metafile dist/route-sidecar/bundle-meta.json && node --experimental-strip-types scripts/route-sidecar-bundle-preflight.ts --bundle dist/route-sidecar/worker.js --bundle dist/route-sidecar/worker.js.map",
    "preflight:route-sidecar": "node --experimental-strip-types scripts/route-sidecar-deployment-preflight.ts --config wrangler.route-sidecar.jsonc --secret-list .wrangler/route-sidecar-secret-names.json",
    "lint": "oxlint adapters agent app features lib components evals product route-sidecar scripts",
    "format": "oxfmt adapters agent app components db features lib evals product route-sidecar scripts",
    "format:check": "oxfmt --check adapters agent app components db features lib evals product route-sidecar scripts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "test:evals": "node --experimental-strip-types --test evals/place-resolution/score-place-resolution.test.mjs evals/place-enrichment/score-place-enrichment.test.mjs",
    "eval:place-resolution": "node evals/place-resolution/score-place-resolution.mjs evals/place-resolution/place-resolution-gold.v1.json evals/place-resolution/place-resolution-predictions.example.v1.json",
    "eval:place-enrichment": "node evals/place-enrichment/score-place-enrichment.mjs evals/place-enrichment/place-enrichment-gold.v1.json evals/place-enrichment/place-enrichment-predictions.example.v1.json",
    "migration:check": "node --experimental-strip-types scripts/migration-packaging.ts --candidate-site-version 17",
    "db:generate": "drizzle-kit generate",
    "maintenance:assessment-reset": "node --experimental-strip-types scripts/assessment-reset-maintenance.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.5.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260905.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.4"
    }
  },
  "type": "module"
}
