{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japan-atlas.example/schemas/place-resolution-gold.v1.json",
  "title": "Japan Atlas place-resolution gold dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "description",
    "checkedAt",
    "entities",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "checkedAt": { "$ref": "#/$defs/date" },
    "entities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/entity" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalName",
        "branchId",
        "branchName",
        "countryCode",
        "locality",
        "address",
        "sourceUrl",
        "checkedAt"
      ],
      "properties": {
        "canonicalName": { "type": "string", "minLength": 1 },
        "branchId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "branchName": { "type": "string", "minLength": 1 },
        "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "locality": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 1 },
        "sourceUrl": { "$ref": "#/$defs/url" },
        "checkedAt": { "$ref": "#/$defs/date" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "query", "tags", "gold"],
      "properties": {
        "caseId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "query": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
        },
        "gold": { "$ref": "#/$defs/gold" }
      }
    },
    "gold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedAction",
        "identityId",
        "branchId",
        "sourceUrls",
        "checkedAt"
      ],
      "properties": {
        "expectedAction": { "enum": ["resolve", "clarify", "no_match"] },
        "identityId": { "type": ["string", "null"] },
        "branchId": { "type": ["string", "null"] },
        "clarificationReason": { "type": "string", "minLength": 1 },
        "curationNote": { "type": "string", "minLength": 1 },
        "clarificationPolicy": { "$ref": "#/$defs/clarificationPolicy" },
        "sourceUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/url" }
        },
        "checkedAt": { "$ref": "#/$defs/date" }
      },
      "allOf": [
        {
          "if": { "properties": { "expectedAction": { "const": "resolve" } } },
          "then": {
            "properties": {
              "identityId": { "type": "string", "minLength": 1 },
              "branchId": { "type": "string", "minLength": 1 }
            }
          },
          "else": {
            "required": ["clarificationReason"],
            "properties": {
              "identityId": { "type": "null" },
              "branchId": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "expectedAction": { "const": "clarify" } } },
          "then": { "required": ["clarificationPolicy"] },
          "else": { "not": { "required": ["clarificationPolicy"] } }
        }
      ]
    },
    "clarificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedModes", "requiredHint"],
      "properties": {
        "acceptedModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ask_location",
              "ask_branch",
              "ask_identity",
              "offer_candidates"
            ]
          }
        },
        "requiredHint": {
          "enum": [
            "area_or_station",
            "branch_or_landmark",
            "restaurant_identity"
          ]
        },
        "allowedCandidates": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidateId", "label"],
            "properties": {
              "candidateId": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "acceptedModes": { "contains": { "const": "offer_candidates" } }
            }
          },
          "then": { "required": ["allowedCandidates"] },
          "else": { "not": { "required": ["allowedCandidates"] } }
        }
      ]
    }
  }
}
