{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japan-atlas.example/schemas/place-resolution-predictions.v1.json",
  "title": "Japan Atlas place-resolution predictions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "datasetId", "predictions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "datasetId": { "type": "string", "minLength": 1 },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "action", "candidateIdentityIds"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "action": { "enum": ["resolve", "clarify", "no_match"] },
          "selectedIdentityId": { "type": "string", "minLength": 1 },
          "clarification": { "$ref": "#/$defs/clarification" },
          "candidateIdentityIds": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "action": { "const": "resolve" } } },
            "then": { "required": ["selectedIdentityId"] },
            "else": { "not": { "required": ["selectedIdentityId"] } }
          },
          {
            "if": { "properties": { "action": { "const": "clarify" } } },
            "then": { "required": ["clarification"] },
            "else": { "not": { "required": ["clarification"] } }
          }
        ]
      }
    }
  },
  "$defs": {
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requestedHint", "question", "candidates"],
      "properties": {
        "mode": {
          "enum": [
            "ask_location",
            "ask_branch",
            "ask_identity",
            "offer_candidates"
          ]
        },
        "requestedHint": {
          "type": ["string", "null"]
        },
        "question": {
          "type": ["string", "null"]
        },
        "candidates": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rank", "candidateId", "label"],
            "properties": {
              "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
              "candidateId": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "offer_candidates" } }
          },
          "then": {
            "properties": {
              "requestedHint": { "type": "null" },
              "question": { "type": "null" },
              "candidates": { "minItems": 2, "maxItems": 3 }
            }
          },
          "else": {
            "properties": {
              "requestedHint": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 },
              "candidates": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
